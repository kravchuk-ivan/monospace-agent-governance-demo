<mxfile host="drawio"><diagram id="riverside" name="Riverside Health × Monospace"><mxGraphModel dx="1400" dy="960" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1380" pageHeight="960" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style='font-size:22px'&gt;Riverside Health × Monospace&lt;/b&gt;&lt;br&gt;Two regulations, two databases, one governed layer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;spacing=8;fillColor=none;strokeColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="50" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;Front-desk agent&lt;/b&gt;&lt;br&gt;Claude · MCP&lt;br&gt;&lt;span style='color:#555'&gt;service account · 30-day key&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;spacing=8;fillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="280" height="80" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Billing agent&lt;/b&gt;&lt;br&gt;Claude · MCP&lt;br&gt;&lt;span style='color:#555'&gt;service account · 30-day key&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;spacing=8;fillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="380" y="90" width="280" height="80" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Patient-360 app&lt;/b&gt;&lt;br&gt;TypeScript · typed SDK&lt;br&gt;&lt;span style='color:#555'&gt;npm run app&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;spacing=8;fillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="720" y="90" width="280" height="80" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;① Shared admin key&lt;/b&gt;&lt;br&gt;the problem: sees SSN, HIV diagnosis,&lt;br&gt;clinical notes, full card numbers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;spacing=8;fillColor=#FDECEA;strokeColor=#C62828;" vertex="1" parent="1"><mxGeometry x="1060" y="90" width="280" height="80" as="geometry"/></mxCell><mxCell id="ms" value="&lt;b style='font-size:18px'&gt;Monospace v1.1&lt;/b&gt; &amp;nbsp;&lt;span style='color:#555'&gt;Rust engine · localhost:8100 · workspace &lt;i&gt;riverside&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;spacing=8;fillColor=#FAFAFF;strokeColor=#3949AB;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="1300" height="420" as="geometry"/></mxCell><mxCell id="ifc" value="&lt;b&gt;One API, three interfaces:&lt;/b&gt; REST &lt;code&gt;/api/riverside/items/*&lt;/code&gt; · typed TypeScript SDK · MCP &lt;code&gt;POST /api/riverside/mcp&lt;/code&gt; (7 tools) · OpenAPI per workspace" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;spacing=8;fillColor=#F5F5F5;strokeColor=#757575;" vertex="1" parent="1"><mxGeometry x="70" y="280" width="1240" height="50" as="geometry"/></mxCell><mxCell id="pol" value="&lt;b&gt;④ Identity → role → policy&lt;/b&gt; &amp;nbsp;&lt;span style='color:#B26A00'&gt;(needs license; Starter returns 402)&lt;/span&gt;&lt;br&gt;&lt;div style='text-align:left;margin-top:6px'&gt;&lt;b&gt;Front desk&lt;/b&gt;: rows where clinicId = 1 · no SSN, diagnosis, notes or visit reason · may set status to scheduled / confirmed / checked_in / cancelled · no card table&lt;br&gt;&lt;b&gt;Billing&lt;/b&gt;: card brand + last 4 only, never the PAN · refunds ≤ $200, above that a human&lt;br&gt;&lt;span style='color:#555'&gt;itemRules · fieldRules · validationRules · entitlements (ai:mcp)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;spacing=8;fillColor=#FFF4E5;strokeColor=#E08A00;" vertex="1" parent="1"><mxGeometry x="70" y="350" width="600" height="160" as="geometry"/></mxCell><mxCell id="keys" value="&lt;b&gt;⑤ API keys&lt;/b&gt;&lt;br&gt;&lt;div style='text-align:left;margin-top:6px'&gt;one identity per key&lt;br&gt;TTL 1h / 7d / 30d&lt;br&gt;PATCH &lt;code&gt;active:false&lt;/code&gt;&lt;br&gt;→ next call &lt;b&gt;401&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;spacing=8;fillColor=#E8F5E9;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="690" y="350" width="300" height="160" as="geometry"/></mxCell><mxCell id="aud" value="&lt;b&gt;⑥ Audit log&lt;/b&gt; &lt;span style='color:#B26A00'&gt;(Business)&lt;/span&gt;&lt;br&gt;&lt;div style='text-align:left;margin-top:6px'&gt;auth events, role and policy changes&lt;br&gt;&lt;br&gt;&lt;i&gt;Open question: does it record which records an agent read? (HIPAA)&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;spacing=8;fillColor=#FFF4E5;strokeColor=#E08A00;" vertex="1" parent="1"><mxGeometry x="1010" y="350" width="300" height="160" as="geometry"/></mxCell><mxCell id="rel" value="&lt;b&gt;② Cross-database relations&lt;/b&gt; &lt;span style='color:#555'&gt;(metadata only, no FK written)&lt;/span&gt;&lt;br&gt;billingAccounts.patient → patients&lt;br&gt;charges.appointment → appointments&lt;br&gt;&lt;span style='color:#555'&gt;one request, both engines, ~10 ms&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;spacing=8;fillColor=#E8F5E9;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="70" y="530" width="600" height="100" as="geometry"/></mxCell><mxCell id="grd" value="&lt;b&gt;③ Source guardrails: every caller, admins included&lt;/b&gt;&lt;br&gt;EHR: no deletes · Payments: no deletes + &lt;b&gt;schema locked&lt;/b&gt;&lt;br&gt;&lt;span style='color:#555'&gt;“deleteOne operation not found” · “schema of data source Payments is locked”&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;spacing=8;fillColor=#E8F5E9;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="690" y="530" width="620" height="100" as="geometry"/></mxCell><mxCell id="ehr" value="&lt;b style='font-size:15px'&gt;EHR · PostgreSQL 17&lt;/b&gt; &amp;nbsp;&lt;span style='color:#C62828'&gt;&lt;b&gt;HIPAA&lt;/b&gt;&lt;/span&gt;&lt;br&gt;clinics (3) · providers (8) · patients (60) · appointments (145)&lt;br&gt;&lt;span style='color:#555'&gt;patients hold SSN, diagnosis code, clinical notes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;spacing=8;fillColor=#FFFFFF;strokeColor=#336791;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="560" height="130" as="geometry"/></mxCell><mxCell id="pay" value="&lt;b style='font-size:15px'&gt;Payments · MySQL 8.4&lt;/b&gt; &amp;nbsp;&lt;span style='color:#C62828'&gt;&lt;b&gt;PCI DSS CDE&lt;/b&gt;&lt;/span&gt;&lt;br&gt;billing_accounts · payment_methods · charges · refunds&lt;br&gt;&lt;span style='color:#555'&gt;payment_methods hold full test PANs&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;spacing=8;fillColor=#FFFFFF;strokeColor=#00758F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="640" y="730" width="460" height="130" as="geometry"/></mxCell><mxCell id="sys" value="&lt;b&gt;Monospace system&lt;/b&gt;&lt;br&gt;Postgres (metadata)&lt;br&gt;Redis (read cache)&lt;br&gt;RabbitMQ (events)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;spacing=8;fillColor=#F5F5F5;strokeColor=#757575;" vertex="1" parent="1"><mxGeometry x="1140" y="730" width="200" height="130" as="geometry"/></mxCell><mxCell id="lg1" value="Works on Starter, verified live" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;spacing=8;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="260" height="36" as="geometry"/></mxCell><mxCell id="lg2" value="Needs a license key" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;spacing=8;fillColor=#FFF4E5;strokeColor=#E08A00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="890" width="260" height="36" as="geometry"/></mxCell><mxCell id="lg3" value="Risk without Monospace" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;spacing=8;fillColor=#FDECEA;strokeColor=#C62828;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="890" width="260" height="36" as="geometry"/></mxCell><mxCell id="lg4" value="Circled numbers = demo beats (npm run demo)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=13;spacing=8;fillColor=none;strokeColor=none;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="880" y="890" width="460" height="36" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.125;entryY=0;strokeColor=#1565C0;" edge="1" parent="1" source="c1" target="ms"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.385;entryY=0;strokeColor=#1565C0;" edge="1" parent="1" source="c2" target="ms"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.646;entryY=0;strokeColor=#1565C0;" edge="1" parent="1" source="c3" target="ms"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.908;entryY=0;strokeColor=#C62828;dashed=1;" edge="1" parent="1" source="c4" target="ms"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="live queries, nothing copied" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.246;exitY=1;entryX=0.5;entryY=0;strokeColor=#336791;" edge="1" parent="1" source="ms" target="ehr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="login without DDL rights" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.646;exitY=1;entryX=0.5;entryY=0;strokeColor=#00758F;" edge="1" parent="1" source="ms" target="pay"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.954;exitY=1;entryX=0.5;entryY=0;strokeColor=#757575;dashed=1;endArrow=none;" edge="1" parent="1" source="ms" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>